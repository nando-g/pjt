\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{vit_template}[2026/10/15 VIT B.Tech Final Year Project Report Package - BCSE497J]

% -------------------------------------------------------------------------
% PAGE GEOMETRY (BCSE497J Guidelines: Left=3.81cm, Right=2.54cm, Top=2.54cm, Bottom=2.54cm)
% -------------------------------------------------------------------------
\RequirePackage[a4paper,
  left=3.81cm,
  right=2.54cm,
  top=2.54cm,
  bottom=2.54cm,
  footskip=1.2cm,
  headheight=15pt]{geometry}

% -------------------------------------------------------------------------
% FONTS & TYPOGRAPHY (Times New Roman 12pt, 1.5 line spacing)
% -------------------------------------------------------------------------
\RequirePackage{mathptmx} % Times Roman font for math and text
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{setspace}
\onehalfspacing % Exactly 1.5 line spacing

% Microtypography and hyphenation relaxation to prevent overfull hboxes
\RequirePackage{microtype}
\emergencystretch=1.5em
\setcounter{tocdepth}{2}

% Prevent orphan / widow lines as per guideline:
% "No paragraph should have its opening line at the bottom of a page"
\widowpenalty=10000
\clubpenalty=10000
\raggedbottom

% Paragraph separation and indentation
\setlength{\parskip}{6pt}
\setlength{\parindent}{0pt}

% -------------------------------------------------------------------------
% MATHEMATICS & ALGORITHMS
% -------------------------------------------------------------------------
\RequirePackage{amsmath, amssymb, amsfonts, amsthm}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{bm}

% -------------------------------------------------------------------------
% GRAPHICS, TABLES & TIKZ
% -------------------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{caption}
\captionsetup{font={small,rm}, labelfont=bf, labelsep=colon, skip=8pt}
\RequirePackage{subcaption}
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, arrows, arrows.meta, positioning, fit, calc, backgrounds, decorations.pathreplacing}

% -------------------------------------------------------------------------
% CODE LISTINGS
% -------------------------------------------------------------------------
\RequirePackage{listings}
\RequirePackage{xcolor}

\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.97,0.97,0.97}

\lstdefinestyle{mystyle}{
    backgroundcolor=\color{backcolour},   
    commentstyle=\color{codegreen},
    keywordstyle=\color{blue}\bfseries,
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\scriptsize,
    breakatwhitespace=false,         
    breaklines=true,                 
    captionpos=b,                    
    keepspaces=true,                 
    numbers=left,                    
    numbersep=5pt,                  
    showspaces=false,                
    showstringspaces=false,
    showtabs=false,                  
    tabsize=2,
    frame=single,
    rulecolor=\color{black!20}
}
\lstset{style=mystyle}

% -------------------------------------------------------------------------
% HEADINGS FORMATTING (BCSE497J Guidelines)
% Chapter Heading: Font Size 16, Bold, Times New Roman
% Section Heading: Font Size 14, Times New Roman, CAPS
% Subsection Heading: Font Size 12, Times New Roman, CAPS
% -------------------------------------------------------------------------
\RequirePackage{titlesec}

% Chapter format
\titleformat{\chapter}[display]
  {\normalfont\fontsize{16}{20}\bfseries\centering}
  {\MakeUppercase{\chaptertitlename\ \thechapter}}
  {10pt}
  {\fontsize{16}{20}\bfseries\MakeUppercase}
\titlespacing*{\chapter}{0pt}{-10pt}{20pt}

% Section format: Font Size 14, Bold, CAPS
\titleformat{\section}
  {\normalfont\fontsize{14}{18}\bfseries}
  {\thesection}{1em}{\MakeUppercase}
\titlespacing*{\section}{0pt}{14pt}{6pt}

% Subsection format: Font Size 12, Bold, CAPS
\titleformat{\subsection}
  {\normalfont\fontsize{12}{15}\bfseries}
  {\thesubsection}{1em}{\MakeUppercase}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}

% Sub-subsection format: Font Size 12, Bold, Title Case
\titleformat{\subsubsection}
  {\normalfont\fontsize{12}{15}\bfseries}
  {\thesubsubsection}{1em}{}
\titlespacing*{\subsubsection}{0pt}{8pt}{3pt}

% -------------------------------------------------------------------------
% HEADERS & FOOTERS (Page numbers at bottom center)
% -------------------------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{} % clear all header and footer fields
\fancyfoot[C]{\fontsize{12}{14}\selectfont\thepage} % bottom center
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Plain page style (used for chapter opening pages)
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\fontsize{12}{14}\selectfont\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% -------------------------------------------------------------------------
% HYPERLINKS & CITATIONS
% -------------------------------------------------------------------------
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    citecolor=black,
    filecolor=black,
    urlcolor=blue
}

% -------------------------------------------------------------------------
% TOC, LOT, LOF FORMATTING
% -------------------------------------------------------------------------
\RequirePackage{tocloft}
\renewcommand{\cfttoctitlefont}{\hfill\fontsize{16}{20}\bfseries\MakeUppercase}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftloftitlefont}{\hfill\fontsize{16}{20}\bfseries\MakeUppercase}
\renewcommand{\cftafterloftitle}{\hfill}
\renewcommand{\cftlottitlefont}{\hfill\fontsize{16}{20}\bfseries\MakeUppercase}
\renewcommand{\cftafterlottitle}{\hfill}

\endinput
